import motor
import motor_pair
import runloop
import color_sensor
from hub import port
import color

motor_pair.pair(motor_pair.PAIR_1,port.A, port.B)


async def main():
    motor_pair.move_tank_for_degrees(motor_pair.PAIR_1,360,-100,100)
    if color_sensor.color(port.C) is color.RED:
        motor.run_for_degrees(port.D,-90,30)
        await runloop.sleep_ms(1000)
        motor.run_for_degrees(port.D,90,90)
    elif color_sensor.color(port.C) is color.GREEN:
        motor.run_for_degrees(port.D,90,30)
        await runloop.sleep_ms(1000)
        motor.run_for_degrees(port.D,-90,90)
    elif color_sensor.color(port.C) is color.YELLOW:
        motor.run_for_degrees(port.D,-180,90)
        await runloop.sleep_ms(2000)
        motor.run_for_degrees(port.D,180,90)
for i in range (1,100):
    runloop.run(main())
